	measure 'Foto Jugador HTML' =
			
			VAR UrlFoto = SELECTEDVALUE(DIM_PLAYER[IMAGE_URL])
			RETURN
			    "<img src='" & UrlFoto &
			    "' style='width:100%;height:100%;object-fit:contain;' />"
